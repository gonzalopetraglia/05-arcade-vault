# Formulario de contacto (/api/contact) — Resend
# Copia este archivo a .env.local y rellena los valores reales.
# Ninguna de estas variables lleva prefijo NEXT_PUBLIC_: son solo de servidor.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinatario del aviso de contacto
CONTACT_TO_EMAIL=equipo@arcadevault.gg

# Remitente. Mientras no haya un dominio verificado en Resend,
# usa el remitente de pruebas onboarding@resend.dev
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Supabase
SUPABASE_DB_PASSWORD=XXXXXXXX
