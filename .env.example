# Formulario de contacto (/api/contact) — Resend
# Copia este archivo a .env.local y rellena los valores reales.
# Ninguna de estas variables lleva prefijo NEXT_PUBLIC_: son solo de servidor.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinatario del aviso de contacto
CONTACT_TO_EMAIL=equipo@arcadevault.gg

# Remitente. Mientras no haya un dominio verificado en Resend,
# usa el remitente de pruebas onboarding@resend.dev
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Supabase
SUPABASE_DB_PASSWORD=XXXXXXXX

# Estas dos sí llevan prefijo NEXT_PUBLIC_: viajan al navegador a propósito.
# La protección real de los datos es la RLS, no el secreto de la clave.
# Nunca pongas aquí la clave secreta (sb_secret_…).

# URL del proyecto de Supabase (Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publicable (Project Settings > API Keys), no la anon JWT heredada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx